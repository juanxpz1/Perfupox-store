# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# ── Base de datos (Railway la crea; copia DATABASE_URL de la pestaña Variables del servicio PostgreSQL) ──
DATABASE_URL="postgresql://usuario:clave@localhost:5432/perfupox"
DATABASE_POOL_MAX=10
# En Railway la conexión interna no usa SSL. Ponlo en true solo si te conectas por la URL pública.
DATABASE_SSL=false

# Base de datos aparte para las pruebas automáticas (se borra en cada ejecución)
TEST_DATABASE_URL="postgresql://usuario:clave@localhost:5432/perfupox_test"

# URL pública de la tienda
APP_URL="http://localhost:3000"

# Datos de demostración en `npm run db:seed` (false por defecto; el catálogo real se carga con db:import-catalog)
SEED_DEMO=false

# ── Autenticación (Fase 4). Genera con: openssl rand -base64 48 ──
AUTH_SECRET=

# ── Addi (Fase 5). Se obtienen al registrarse como comercio aliado. Sin ellos, Addi no aparece en el checkout ──
ADDI_CLIENT_ID=
ADDI_CLIENT_SECRET=
ADDI_ALLY_SLUG=
ADDI_ENVIRONMENT=staging
ADDI_CALLBACK_SECRET=

# ── Almacenamiento de imágenes y comprobantes (compatible con S3, por ejemplo Cloudflare R2) ──
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ── Correo transaccional (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="Perfupox <pedidos@tu-dominio.co>"
